# 复制成 server/.env 后填写。server/.env 已被 .gitignore，不会进版本库。
# 必填（二选一）：
#   官方：ANTHROPIC_API_KEY=sk-ant-…
#   Bearer 型网关（智谱 GLM 等）：ANTHROPIC_BASE_URL + ANTHROPIC_AUTH_TOKEN，
#   此时 ANTHROPIC_API_KEY 留空。GLM 时 XZ_LLM_MODEL=glm-5.3-flash、
#   XZ_LLM_THINKING 必须保持 disabled（GLM 不传 thinking 会先思考、吃光 max_tokens）。
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
# ANTHROPIC_AUTH_TOKEN=

# ---------- 监听 ----------
XZ_HOST=0.0.0.0
XZ_PORT=8095
# OTA 下发给设备的 ws 地址；留空则按请求的 Host 头自动推断
# XZ_PUBLIC_WS_URL=ws://192.168.1.20:8095/xiaozhi/v1/
# WS 鉴权 token（同时下发给 OTA）；留空 = 不校验
XZ_TOKEN=
# Device-Id(MAC) 白名单，逗号分隔；留空 = 谁都能连。
# 服务开在公网时建议填上真机 MAC（第一次连上后看日志里的 device_id）
XZ_ALLOWED_DEVICE_IDS=

# ---------- 音频 ----------
XZ_DOWNLINK_SAMPLE_RATE=24000
XZ_FRAME_MS=60
# 二进制帧协议版本：1=裸 Opus（默认，最简单），2/3=带头
XZ_PROTOCOL_VERSION=1

# ---------- VAD ----------
XZ_VAD_SILENCE_MS=800
XZ_VAD_MIN_SPEECH_MS=300
XZ_VAD_MAX_UTTERANCE_MS=15000
XZ_VAD_AGGRESSIVENESS=2
# 断句模型（README §3.3.1）：留空 = 只看静音 + 语气词 / 问号规则
# XZ_TURN_MODEL=/srv/models/smart-turn/smart-turn-v3.2-cpu.onnx
# XZ_TURN_INCOMPLETE_MS=1600   # 模型说没说完
# XZ_TURN_OPEN_MS=2000         # 识别停在「然后 / 就是」上
# XZ_TURN_FILLER_MS=2500       # 只有「嗯」「啊」
# XZ_TURN_IGNORE_FILLERS=1     # 等完还是只有语气词就不回话

# ---------- ASR ----------
# sherpa-onnx  = 边听边认（流式，默认）。帧到就解，listen stop 后只收尾 ~15 ms。
# faster-whisper = 旧路径，说完才整段转写，stop 后 1.2–1.6 s。想退回就改这一行。
# null         = 不识别，调链路用
XZ_ASR_PROVIDER=sherpa-onnx
# sherpa-onnx 模型目录（GitHub release 的 tar.bz2 解开），相对路径按 server/ 算。
# EX10 生产位：/srv/models/sherpa-onnx-streaming-zipformer-bilingual-zh-en-2023-02-20
XZ_ASR_MODEL_DIR=
# onnxruntime 线程数（EX10 上 4 足够，stop 后 10–25 ms）
XZ_ASR_NUM_THREADS=4
# 收尾补多少静音，让最后一个字解出来
XZ_ASR_TAIL_PADDING_MS=300
# int8 = 优先用目录里的 .int8.onnx（encoder/joiner）；填别的就用 fp32
XZ_ASR_COMPUTE_TYPE=int8
# 下面三个只对 faster-whisper 有效
XZ_ASR_MODEL=small
XZ_ASR_LANGUAGE=zh
XZ_ASR_DEVICE=cpu

# ---------- LLM ----------
XZ_LLM_MODEL=claude-sonnet-5
XZ_LLM_MAX_TOKENS=1024
# adaptive | disabled  —— 语音场景默认 disabled 换低延迟
XZ_LLM_THINKING=disabled
# low | medium | high | xhigh | max
XZ_LLM_EFFORT=low
XZ_LLM_HISTORY_TURNS=8
# 本地大脑优先（README §3.3.2）：TP3 上的 vLLM；连不上 / 出错 / 首字太慢就这一轮退回上面的云端
# XZ_LLM_LOCAL_BASE_URL=http://127.0.0.1:8888
# XZ_LLM_LOCAL_MODEL=GLM-5.3-Flash-EXL3
# XZ_LLM_LOCAL_FIRST_S=2.5
XZ_SESSION_IDLE_SECONDS=600
# 首句切分：遇到逗号/顿号/句号即切，到上限还没标点就硬切（只影响第一句）
XZ_LLM_FIRST_MIN_CHARS=2
XZ_LLM_FIRST_MAX_CHARS=15
# LLM 抢跑：识别结果稳定 + VAD 判人已停口，就先把问题发给 LLM，不等 listen stop。
# 命中就直接接着用（实测提前 0.2–0.6 s 起跑），没命中就撤掉重来（多一次很短的调用）。
XZ_LLM_SPECULATIVE=1
XZ_LLM_SPECULATIVE_SILENCE_MS=200
XZ_LLM_SPECULATIVE_STABLE_MS=150

# ---------- 人设 ----------
XZ_PERSONA_FILE=../persona/bright-junior-persona.md
# 模板里的【用户称呼】等占位，留空就不注入
XZ_USER_TITLE=
XZ_ASSISTANT_NAME=布莱特
XZ_SKILLS=

# ---------- TTS ----------
# edge = 微软 Edge 神经语音（免 key，默认，ClaudeVoice 同款）
# voxtts = VoxCPM2（局域网 Windows 那台，严格串行）
XZ_TTS_PROVIDER=edge
# edge 音色：中文别名 茉莉/冰糖/白桦/苏打，或 zh-CN-XiaoxiaoNeural 这类原名
# voxtts 音色：my_voice 等。留空 = 各 provider 默认（edge=茉莉，voxtts=my_voice）
XZ_TTS_VOICE=茉莉
# 仅 voxtts 用（edge 走 speech.platform.bing.com，不需要 base_url）
XZ_TTS_BASE_URL=http://127.0.0.1:4690
XZ_TTS_TIMEOUT=120
# 说完后静音这么久就先握 Edge 的连接（把 ~0.9 s 握手藏进说话的尾巴里）
XZ_TTS_PREWARM_SILENCE_MS=250
# volc = 豆包语音 2.0（火山引擎，按字收费，新账号送 2 万字试用）；出错自动退回 Edge 茉莉。
#   XZ_TTS_VOICE 填豆包音色 ID，如 zh_female_xiaohe_uranus_bigtts（小何 2.0，会八种方言）
#   key 用 doubao-key 录：XZ_VOLC_API_KEY=
# 语音指令（不计费），如「用上海话说」
XZ_VOLC_INSTRUCTION=
# 语速 -50..100，0 = 原速
XZ_VOLC_SPEECH_RATE=0
# 盒子上让模型直接用方言写回答（如 上海话），配合上面的指令念得更地道；飞书不受影响
XZ_VOICE_DIALECT=

# ---------- 保活 ----------
XZ_WS_HEARTBEAT=30

# ---------- 局域网直连（可选，默认关） ----------
# 盒子在家连 Wi-Fi 时，OTA 请求经 Cloudflare 进来、CF-Connecting-IP 等于本机公网出口
# IP（同一个 NAT 出口），这时 OTA 就回下面这个局域网 ws，省掉隧道那 ~0.6 s 往返；
# 其他来源（4G、外网）照旧回公网 wss。留空 = 关闭。
# 开之前先把 XZ_HOST 改成 0.0.0.0，否则只听 127.0.0.1，局域网连不上。
# XZ_LAN_WS_URL=ws://192.168.1.20:8095/xiaozhi/v1/
# 本机公网出口 IP（逗号分隔）；留空 = 启动时自动探测、每 10 分钟刷新
# XZ_LAN_PUBLIC_IPS=
# 直连进来、源地址就是私网的，也算「在家」（默认 1）
# XZ_LAN_TRUST_PRIVATE=1

# ---------- 联网搜索 ----------
# tavily = 云端搜索 API（要 key）；searxng = 自建实例，查询词不出内网
XZ_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# XZ_SEARXNG_URL=http://127.0.0.1:8080
# XZ_SEARCH_MAX_RESULTS=5
# XZ_SEARCH_ALWAYS=0        # 1 = 每轮都挂搜索工具，不走关键词闸门（会慢 1~2s）
# XZ_SEARCH_HEDGE_S=3.5     # Tavily 这么久没回就同时问 SearXNG；0 = 不对冲
# XZ_NEWS_HOTLIST=1         # 「今天有什么新闻」走 NewsNow 热榜
# XZ_NEWSNOW_SOURCES=thepaper,cls-hot,weibo

# ---------- 飞书入口（可选，默认关） ----------
# 在飞书 App 里跟机器人打字聊天，或者用输入框那个「语音转文字」说话——
# 转写在飞书客户端做，免费而且比盒子本地的准。走飞书长连接，机器人主动连出去，
# 所以 EX10 在 NAT 后面不用开端口、不用隧道。
# 注意：按住说话发的「语音条」到我们这儿没有文字（要转写就得花钱），会被回一句提示。
# XZ_FEISHU_ENABLED=1
# XZ_FEISHU_APP_ID=cli_xxxxxxxxxxxx
# XZ_FEISHU_APP_SECRET=            # 用 server/tools/feishu-key 交互填，别手抄进这里
# 只让这些人聊（open_id，逗号分隔）。留空 = 谁加了机器人都能聊，不推荐。
# XZ_FEISHU_ALLOWED_OPEN_IDS=ou_xxxxxxxx
# XZ_FEISHU_HISTORY_TURNS=12

# ---------- 播报（别的程序往盒子推一句话） ----------
# 留空 = 关掉 POST /xiaozhi/announce
XZ_ANNOUNCE_TOKEN=
# 静默时段：这段时间来的直接丢，盒子也不轮询；填 off 就全天都播
# XZ_ANNOUNCE_QUIET=23:00-08:00
# XZ_ANNOUNCE_TZ=Asia/Shanghai
# XZ_ANNOUNCE_MERGE_S=10      # 第一条到了等几秒，期间来的合成一段念
# XZ_ANNOUNCE_TTL_S=900       # 多久还没念出去就丢
# XZ_ANNOUNCE_REWRITE=1       # 先让大模型改写成一句口语

# ---------- 吴语配音（tools/wu_server.py，见 README） ----------
# XZ_TTS_PROVIDER=cosyvoice   # 只用自建吴语配音，出错退 Edge
# XZ_COSYVOICE_URL=http://127.0.0.1:8097
# XZ_VOICE_DIALECT=上海话
# 用 volc 时也能串上吴语配音：这段时间先用本地配音，其余时间豆包优先
# XZ_TTS_LOCAL_HOURS=23:00-11:00

# ---------- 其他 ----------
# XZ_HOME_CITY=上海           # 问天气没说城市时查哪里
# TAVILY_API_KEYS=key1,key2   # 多个 key 按顺序用，当月额度用完换下一个
